class Main
    integer count = 0

    action Main
        output "Hello from native Quorum"
        number x = 0.1 + 2
        output "x is " + x

        repeat 3 times
            count = count + 1
        end

        if count = 3 and x > 2
            output "count is " + count
        elseif count > 3
            output "too many"
        else
            output "too few"
        end

        integer i = 0
        repeat while i < 5
            if i mod 2 = 0
                output i + " is even"
            end
            i = i + 1
        end

        output "Fibonacci(25) = " + Fibonacci(25)

        Counter counter
        counter:Add(5)
        output "counter is " + counter:Get()

        text digits = "42"
        integer parsed = cast(integer, digits)
        output parsed / 5
        output 7 / 2.0
        output not (parsed > 40)
    end

    action Fibonacci(integer n) returns integer
        if n < 2
            return n
        end
        return Fibonacci(n - 1) + Fibonacci(n - 2)
    end
end
