package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Behaviors.Behavior
use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.SceneEditor
use Libraries.Interface.Events.MouseEvent
use Libraries.Interface.Controls.Scenes.Layers.EditorLayer3D
use Libraries.Interface.Controls.Scenes.Items.EditorCamera3D
use Libraries.Compute.Vector3

/*
    CameraMousePanBehavior zooms and pans the 3D Scene Editor camera with the mouse.
    Scrolling the mouse wheel moves the camera toward or away from the point it is
    orbiting. Dragging moves the point the camera orbits (and the camera with it)
    sideways and up or down relative to the camera's view.
*/
class CameraMousePanBehavior is Behavior
    constant number PAN_SENSITIVITY = 0.05

    // How much one unit of scrolling changes the distance when the camera is DEFAULT_DISTANCE away.
    // Zooming is proportional to the distance so it feels the same whether near or far.
    constant number SCROLL_SPEED = 0.2
    constant number DEFAULT_DISTANCE = 10
    
    action Run(BehaviorEvent event)
        if not (event:GetItem() is SceneEditor)
            return now
        end

        SceneEditor editor = cast(SceneEditor, event:GetItem())
        if not (editor:GetSelectedLayer() is EditorLayer3D)
            return now
        end

        MouseEvent mouseEvent = event:GetMouseEvent()
        if mouseEvent = undefined
            return now
        end

        EditorLayer3D layer = cast(EditorLayer3D, editor:GetSelectedLayer())
        EditorCamera3D camera = layer:GetEditorCamera()
        
        if mouseEvent:IsScrolled()
            number scrollDelta = mouseEvent:scrollAmount
            number distanceScale = camera:GetDistance() / DEFAULT_DISTANCE
            camera:ChangeDistance(-scrollDelta * SCROLL_SPEED * distanceScale)
            editor:EditorCameraChanged()
        elseif mouseEvent:IsDragged()
            integer deltaX = mouseEvent:GetMovementX()
            integer deltaY = mouseEvent:GetMovementY()
    
            Vector3 cameraDirection = camera:GetDirection():Copy()
            Vector3 worldUp
            worldUp:Set(0, 1, 0)
    
            // right vector = direction crossed with world up
            Vector3 right = cameraDirection:Copy():CrossProduct(worldUp)
            right:Normalize()
    
            // up vector = right crossed with direction (gives a true camera-local up)
            Vector3 up = right:Copy():CrossProduct(cameraDirection)
            up:Normalize()
    
            Vector3 change
            change:SetX((right:GetX() * -deltaX + up:GetX() * deltaY) * PAN_SENSITIVITY)
            change:SetY((right:GetY() * -deltaX + up:GetY() * deltaY) * PAN_SENSITIVITY)
            change:SetZ((right:GetZ() * -deltaX + up:GetZ() * deltaY) * PAN_SENSITIVITY)
    
            camera:MovePivot(change)
            editor:EditorCameraChanged()
        end
    end
end
