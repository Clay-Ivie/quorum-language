package Libraries.Interface.Behaviors.Scenes.Camera

use Libraries.Interface.Events.BehaviorEvent
use Libraries.Interface.Controls.Scenes.SceneEditor

/*
    CameraCenterOnSelectionBehavior makes the 3D Scene Editor camera orbit directly around
    the selected item, or the cursor if nothing is selected. This removes any offset left
    over from panning or looking around with the mouse, so that orbiting rotates around the
    chosen object again.
*/
class CameraCenterOnSelectionBehavior is SceneEditorCameraBehavior

    action Run(BehaviorEvent event)
        SceneEditor editor = GetSceneEditor(event)
        if editor not= undefined
            editor:CenterCameraOnSelection()
        end
    end
end
